# ── Rider 연동 / Android 빌드 캐시 ──
[Aa]ssets/Plugins/Editor/JetBrains*
.gradle/
ExportedObj/

# ── Unity 크래시 / 진단 파일 ──
sysinfo.txt
crashlytics-build.properties

# ── OS 생성 파일 ──
.DS_Store
Thumbs.db
Desktop.ini

# ── 오피스(Word/Excel 등) 임시 잠금 파일 ──
~$*

# ── 편집기 백업 / 스왑 파일 ──
*.orig
*~

# ── 기획 문서 (버전관리 제외) ──
/Docs/

# ── meta 파일은 반드시 포함 (강제 예외) ──
!/[Aa]ssets/**/*.meta

